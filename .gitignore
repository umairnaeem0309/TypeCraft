# --- Student / development data (NEVER commit) ---------------------------------
# _dev_data/ holds the live writable copies used when running from source:
# typecraft.db plus the teacher-editable JSON. Committing it would publish
# student records and could clobber a real database on checkout.
_dev_data/
*.db
*.db-wal
*.db-shm
typecraft.log

# --- Python bytecode / caches --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Virtual environments ------------------------------------------------------
.venv/
venv/
env/

# --- PyInstaller build output --------------------------------------------------
build/
dist/
*.spec.bak
# Defensive: if PyInstaller or a manual run ever drops artifacts inside the package,
# never commit them.
typecraft/*.exe
typecraft/_internal/
typecraft/badges.json
typecraft/lessons.json
typecraft/messages.json
typecraft/settings.json

# --- Profiling / runtime artifacts ---------------------------------------------
typecraft_profile*.csv

# --- Editor / OS noise ---------------------------------------------------------
.vscode/
.idea/
desktop.ini
Thumbs.db
*.swp

# Transient probe written by tests/integration/test_no_native_crash.py
_native_crash_probe.py
_live_check.py
typecraft-crash.log
